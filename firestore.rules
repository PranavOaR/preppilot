rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Fields that must only be written server-side (via Admin SDK) or by admins.
    // Clients (including the authenticated owner) cannot touch these.
    function touchesSensitiveFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'plan', 'planExpiresAt', 'purchasedInterviews']);
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      // Owner may update profile/game fields but NOT role, plan, planExpiresAt, purchasedInterviews.
      allow update: if (isOwner(userId) && !touchesSensitiveFields()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Problems ───
    match /problems/{problemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Submissions ───
    match /submissions/{submissionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Progress ───
    // doc ID: {userId}_{topic}
    match /progress/{progressId} {
      allow read: if isSignedIn() &&
        (progressId.matches(request.auth.uid + '_.*') || isAdmin());
      allow write: if isSignedIn() && progressId.matches(request.auth.uid + '_.*');
    }

    // ─── Activity Log ───
    // doc ID: {userId}_{date}
    match /activity/{activityId} {
      allow read: if isSignedIn() &&
        (activityId.matches(request.auth.uid + '_.*') || isAdmin());
      allow write: if isSignedIn() && activityId.matches(request.auth.uid + '_.*');
    }

    // ─── Contests ───
    match /contests/{contestId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Contest Participants ───
    // doc ID: {contestId}_{userId}
    match /contestParticipants/{participantId} {
      allow read: if isSignedIn();
      // Only the participant themselves can create/update their own record
      allow create: if isSignedIn() && participantId.matches('.*_' + request.auth.uid);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Contest Submissions ───
    // doc ID: {contestId}_{userId}_{problemId}
    match /contestSubmissions/{submissionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Hint Cache (global cache, read by all signed-in users) ───
    // Writes must go through the hints API route (which uses Admin SDK) or an admin.
    // Direct client writes are blocked to prevent cache poisoning.
    match /hintCache/{hintId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Hint Usage ───
    // doc ID: {userId}_{problemId}_level{N}
    match /hintUsage/{usageId} {
      allow read: if isSignedIn() &&
        (usageId.matches(request.auth.uid + '_.*') || isAdmin());
      allow write: if isSignedIn() && usageId.matches(request.auth.uid + '_.*');
    }

    // ─── Interview Sessions ───
    match /interviewSessions/{sessionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Q&A subcollection — only the session owner
      match /questions/{index} {
        allow read, write: if isSignedIn() &&
          get(/databases/$(database)/documents/interviewSessions/$(sessionId)).data.userId == request.auth.uid;
      }
    }

    // ─── Interview Feedback ───
    match /interviewFeedback/{sessionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ─── Payments ───
    // Written by the server (Admin SDK). Clients can create their own record as fallback
    // when Admin SDK is not configured; only admins can read all records.
    match /payments/{paymentId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Bookmarks ───
    // doc ID: {userId}_{problemId}
    match /bookmarks/{bookmarkId} {
      allow read, write: if isSignedIn() && bookmarkId.matches(request.auth.uid + '_.*');
    }

    // ─── Mock Tests ───
    match /mockTests/{testId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Mock Test Attempts ───
    match /mockTestAttempts/{attemptId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

  }
}
