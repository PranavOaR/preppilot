rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // ─── Users ───
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ─── Problems ───
    match /problems/{problemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Submissions ───
    match /submissions/{submissionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ─── Progress ───
    match /progress/{progressId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Activity Log ───
    match /activity/{activityId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Contests ───
    match /contests/{contestId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Contest Participants ───
    match /contestParticipants/{participantId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Contest Submissions ───
    match /contestSubmissions/{submissionId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Hint Cache (shared, read by all, written server-side only) ───
    match /hintCache/{hintId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // API route handles generation logic
    }

    // ─── Hint Usage ───
    match /hintUsage/{usageId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ─── Interview Sessions ───
    match /interviewSessions/{sessionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Q&A subcollection
      match /questions/{index} {
        allow read, write: if isSignedIn();
      }
    }

    // ─── Interview Feedback ───
    match /interviewFeedback/{sessionId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isSignedIn();
    }

    // ─── Payments ───
    match /payments/{paymentId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

  }
}
